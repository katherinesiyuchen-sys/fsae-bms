	(text "Low-pass filter\n"
		(exclude_from_sim no)
		(at 67.564 34.036 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2cdc27ef-3e0b-4efa-baca-246db20ae50e")
	)
	(text "At low frequency, cap is effectively open (signal passes thru resistor unchanged)\nAt high freq, cap is a short to ground, \nresistor + capacitor form a divider that attenuates the signal.\nfc = 1/(2π · R · C)\n   = 1/(2π · 1000 · 100×10⁻⁹)\n   = 1.6 kHz\n\nBelow 1.6kHz passes. Cell voltage is slow, under a load step it \nmoves over tens of milliseconds, that's tens of Hz. 1.6kHz passes \nit with no lag. Noise is fast, the buck switches at hundreds of kHz. "
		(exclude_from_sim no)
		(at 39.37 72.898 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "83592b6d-d576-491d-a043-36ae9e15d7d4")
	)
