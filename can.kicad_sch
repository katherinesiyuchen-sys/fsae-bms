	)
	(text "Datasheet: https://www.nxp.com/docs/en/data-sheet/TJA1051.pdf\n\nCAN is differential sensing, so it rejects the common-mode noise a motor\ncontroller injects. Degrades to single-wire. Priority-based arbitration, \nso a fault frame wins the bus.\n\n"
		(exclude_from_sim no)
		(at 15.748 54.864 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "79c64e8a-95be-49f4-b67c-ced62bc266c4")
	)
	(text "S is tied to GND directly.\nHIGH selects Silent mode \n(receives but never transmits)"
